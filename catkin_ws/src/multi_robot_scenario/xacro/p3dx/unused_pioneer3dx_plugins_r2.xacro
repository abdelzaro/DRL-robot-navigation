<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Joint-state publisher plugin (namespaced for r2)             -->
  <xacro:macro name="pioneer3dx_joints_state_publisher">
    <gazebo>
      <plugin name="r2_joint_state_publisher"
              filename="libgazebo_ros_joint_state_publisher.so">
        <!-- All topics and TF frames live under /r2 -->
        <robotNamespace>r2</robotNamespace>
        <jointName>
          chassis_swivel_joint,
          swivel_wheel_joint,
          left_hub_joint,
          right_hub_joint
        </jointName>
        <updateRate>50.0</updateRate>
        <alwaysOn>true</alwaysOn>
      </plugin>
    </gazebo>
  </xacro:macro>


  <!-- Differential-drive plugin (namespaced for r2)                -->
  <xacro:macro name="pioneer3dx_diff_drive">
    <gazebo>
      <plugin name="r2_diff_drive_controller"
              filename="libgazebo_ros_diff_drive.so">
        <rosDebugLevel>Debug</rosDebugLevel>

        <!-- Namespace so all produced topics become /r2/... -->
        <robotNamespace>r2</robotNamespace>

        <!-- Do not publish TF from this plugin (handled by robot_state_publisher) -->
        <publishWheelTF>false</publishWheelTF>
        <publishWheelJointState>true</publishWheelJointState>
        <alwaysOn>true</alwaysOn>

        <!-- Wheels (link names exactly as in your URDF) -->
        <leftJoint>left_hub_joint</leftJoint>
        <rightJoint>right_hub_joint</rightJoint>

        <!-- Robot geometry -->
        <wheelSeparation>0.3</wheelSeparation>
        <wheelDiameter>0.18</wheelDiameter>

        <!-- Dynamics -->
        <wheelTorque>20</wheelTorque>
        <wheelAcceleration>1.8</wheelAcceleration>

        <!-- Topic names (already inside r2 namespace) -->
        <commandTopic>cmd_vel</commandTopic>          <!-- /r2/cmd_vel -->
        <odometryTopic>odom</odometryTopic>           <!-- /r2/odom -->

        <!-- Frames -->
        <odometryFrame>odom</odometryFrame>           <!-- /r2/odom -->
        <robotBaseFrame>base_link</robotBaseFrame>    <!-- /r2/base_link -->

        <updateRate>50</updateRate>
      </plugin>
    </gazebo>
  </xacro:macro>

</robot>
