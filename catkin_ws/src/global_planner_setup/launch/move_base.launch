<launch>
  <param name="use_sim_time" value="true"/>

  <rosparam file="$(find global_planner_setup)/config/costmap_common_params.yaml" command="load" ns="global_costmap"/>
  <rosparam file="$(find global_planner_setup)/config/costmap_common_params.yaml" command="load" ns="local_costmap"/>

  <!-- Load global costmap -->
  <rosparam file="$(find global_planner_setup)/config/global_costmap_params.yaml" command="load" ns="global_costmap"/>

  <!-- Load local costmap -->
  <rosparam file="$(find global_planner_setup)/config/local_costmap_params.yaml" command="load" ns="local_costmap"/>

  <!-- Start move_base -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <param name="base_global_planner" value="navfn/NavfnROS"/>
    <param name="base_local_planner" value="base_local_planner/TrajectoryPlannerROS"/>
  </node>
</launch>
